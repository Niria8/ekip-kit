{
  "extraKnownMarketplaces": {
    "ekip-kit-marketplace": {
      "source": {
        "source": "github",
        "repo": "ORG/ekip-kit"
      }
    }
  },
  "enabledPlugins": {
    "ekip-kit@ekip-kit-marketplace": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- :*)",
      "Bash(git restore:*)",
      "Bash(npm publish:*)",
      "Bash(docker push:*)",
      "Bash(terraform apply:*)",
      "Bash(kubectl delete:*)"
    ]
  }
}
